# Select the JSON config used when no --config argument is supplied.
VPN_SERVER_CONFIG=config/server.example.json
VPN_CLIENT_CONFIG=config/client.user.example.json

# Keep these values in sync with the selected JSON config and credentials file.
VPN_SERVER_HOST=127.0.0.1
VPN_SERVER_PORT=9443
VPN_CREDENTIALS_FILE=credentials/users.json

# These values apply to the selected client config. Generate a PSK with:
# python main.py gen-psk
VPN_CLIENT_SERVER_HOST=127.0.0.1
VPN_CLIENT_SERVER_PORT=9443
VPN_CLIENT_IDENTITY=user
VPN_CLIENT_PSK_HEX=REPLACE_WITH_USER_64_HEX_CHARS
VPN_TLS_CA_FILE=certs/server.crt

# Keep both identity PSKs available when provisioning credentials.
VPN_OWNER_PSK_HEX=REPLACE_WITH_OWNER_64_HEX_CHARS
VPN_USER_PSK_HEX=REPLACE_WITH_USER_64_HEX_CHARS








